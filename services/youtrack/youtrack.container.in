# Podman Quadlet template. ./homeserver install fills in the placeholders from .env
# and saves it as ~/.config/containers/systemd/youtrack.container
[Unit]
Description=YouTrack (rootless Podman)
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/jetbrains/youtrack:@YOUTRACK_VERSION@
ContainerName=youtrack
# Map my user to UID/GID 13001 (YouTrack's user) so folders need no chown
UserNS=keep-id:uid=13001,gid=13001
PublishPort=@YOUTRACK_PORT@:8080/tcp
Environment=TZ=@TZ@
Environment="YOUTRACK_BASE_URL=http://@SERVER_IP@:@YOUTRACK_PORT@"
Volume=%h/.local/share/youtrack/data:/opt/youtrack/data
Volume=%h/.local/share/youtrack/conf:/opt/youtrack/conf
Volume=%h/.local/share/youtrack/logs:/opt/youtrack/logs
Volume=%h/.local/share/youtrack/backups:/opt/youtrack/backups

[Service]
Restart=always

[Install]
WantedBy=default.target
