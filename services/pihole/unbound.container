# Unbound service (rootless Podman Quadlet).
# ./homeserver install copies this file to ~/.config/containers/systemd/unbound.container
[Unit]
Description=Unbound DNS resolver for Pi-hole
# Unbound lives in Pi-hole's network, so Pi-hole must start first.
# BindsTo: if Pi-hole stops or restarts, Unbound stops too, and Pi-hole's
# Wants=unbound.service starts it again in the new network.
BindsTo=pihole.service
After=pihole.service

[Container]
Image=localhost/pihole-unbound:latest
ContainerName=unbound
# Share Pi-hole's network: Pi-hole reaches Unbound on 127.0.0.1:5335.
# No published ports, so nothing outside Pi-hole can reach it.
Network=container:pihole
# Hardening: files inside the container can't be changed,
# and no process can gain extra privileges
ReadOnly=true
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
