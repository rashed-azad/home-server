# Unbound DNS resolver for Pi-hole. install.sh builds this image locally.
FROM docker.io/library/alpine:latest

# unbound     = the DNS resolver
# dnssec-root = the official DNSSEC root key (used to check signatures)
RUN apk add --no-cache unbound dnssec-root

COPY unbound.conf /etc/unbound/unbound.conf

# Stop the build if the config has a mistake
RUN unbound-checkconf

CMD ["unbound", "-d"]
