# Podman Quadlet template. ./homeserver install fills in the placeholders from .env
# and saves it as ~/.config/containers/systemd/pihole.container
[Unit]
Description=Pi-hole (rootless Podman)
# Unbound joins Pi-hole's network, so it starts after Pi-hole (see unbound.container)
Wants=network-online.target unbound.service
After=network-online.target
# Never give up retrying (see Restart= below)
StartLimitIntervalSec=0

[Container]
Image=docker.io/pihole/pihole:latest
ContainerName=pihole
# Keep the real client IP (default rootless mode hides it).
Network=slirp4netns:port_handler=slirp4netns
# Only on the LAN IP, so it does not clash with systemd-resolved (127.0.0.53)
PublishPort=@SERVER_IP@:53:53/tcp
PublishPort=@SERVER_IP@:53:53/udp
PublishPort=@SERVER_IP@:@PIHOLE_WEB_PORT@:80/tcp
Environment=TZ=@TZ@
Environment=FTLCONF_dns_listeningMode=all
# Send allowed queries to Unbound, which runs in this container's network.
# Unbound already checks DNSSEC, so Pi-hole doesn't need to.
Environment="FTLCONF_dns_upstreams=127.0.0.1#5335"
Environment="FTLCONF_dns_dnssec=false"
# filter-AAAA: never hand out IPv6 answers to LAN clients.
# address=: every *.HOME_DOMAIN name -> this server (Caddy picks the service).
Environment="FTLCONF_misc_dnsmasq_lines=filter-AAAA;address=/@HOME_DOMAIN@/@SERVER_IP@"
# Contains FTLCONF_webserver_api_password
EnvironmentFile=%h/.config/pihole/pihole.env
Volume=%h/.local/share/pihole/etc-pihole:/etc/pihole
AutoUpdate=registry

[Service]
# Pi-hole only listens on SERVER_IP. At boot Wi-Fi can be slower than Pi-hole,
# so wait until this computer has that address (up to 2 minutes).
ExecStartPre=/usr/bin/timeout 120 /bin/sh -c 'until ip -4 -br addr | grep -qF " @SERVER_IP@/"; do sleep 1; done'
TimeoutStartSec=180
# If it still fails, try again every 5 seconds
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
