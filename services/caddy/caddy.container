# Podman Quadlet unit. ./homeserver install copies it to
# ~/.config/containers/systemd/caddy.container
[Unit]
Description=Caddy reverse proxy (rootless Podman)
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/library/caddy:2
ContainerName=caddy
# Use the server's network directly: listens on port 80 of every address
# (LAN and Tailscale) and reaches the services on SERVER_IP:<port>.
Network=host
# Made from Caddyfile.in by service.sh
Volume=%h/.config/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=%h/.local/share/caddy:/data
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
