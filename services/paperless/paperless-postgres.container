# Paperless database. PostgreSQL 18 keeps its data in /var/lib/postgresql/18/.
[Unit]
Description=Paperless database (PostgreSQL)

[Container]
Image=docker.io/library/postgres:18
ContainerName=paperless-postgres
Network=paperless.network
Environment=POSTGRES_USER=paperless
Environment=POSTGRES_DB=paperless
Environment=POSTGRES_INITDB_ARGS=--data-checksums
# Contains POSTGRES_PASSWORD
EnvironmentFile=%h/.config/paperless/db.env
Volume=%h/.local/share/paperless/database:/var/lib/postgresql
PodmanArgs=--shm-size=128m

[Service]
Restart=always

[Install]
WantedBy=default.target
