# Settings for all services. Copy to .env and edit:
#   cp .env.example .env
# .env is not saved in git.

# --- Shared ---------------------------------------------------------
# LAN IP of this server. Leave empty to detect it automatically.
SERVER_IP=
# Names end in this, e.g. http://immich.home (Pi-hole points every *.home name
# to this server, Caddy picks the service). Use home, lan or home.arpa - not local
HOME_DOMAIN=home
# Home network shared over Tailscale, e.g. 192.168.1.0/24. Empty = detect.
LAN_SUBNET=
TZ=Europe/Berlin
# Where "./homeserver backup" saves to, e.g. a USB disk: /media/rashed/MyUSB/home-server
BACKUP_DIR=

# --- Pi-hole --------------------------------------------------------
PIHOLE_PASSWORD=change-me
PIHOLE_WEB_PORT=8080

# --- YouTrack -------------------------------------------------------
YOUTRACK_VERSION=2026.2.19840
YOUTRACK_PORT=8081

# --- Jellyfin (web: port 8096) ---------------------------------------
JELLYFIN_VERSION=12.4
# Folder with your movies and shows (no spaces)
JELLYFIN_MEDIA_DIR=/home/rashed/Media
JELLYFIN_MEM_LIMIT=3g
JELLYFIN_CPUS=4
# Leave empty at first. After the setup wizard:
# Dashboard > API Keys > +, paste it here, run install.sh again.
JELLYFIN_API_KEY=

# --- Immich ---------------------------------------------------------
IMMICH_VERSION=v3.4.1
IMMICH_PORT=2283
# Photos and videos (copy this folder to USB for backup)
IMMICH_PHOTOS_DIR=/home/rashed/immich/photos
# Database: must be on the internal disk (SSD), not USB or network
IMMICH_DB_DIR=/home/rashed/immich/database
# Letters and numbers only (A-Z a-z 0-9)
IMMICH_DB_PASSWORD=change-me

# --- Paperless-ngx --------------------------------------------------
PAPERLESS_VERSION=3.5.1
PAPERLESS_WEB_PORT=8000
# Drop files here to import them (no spaces). Point your scanner here.
PAPERLESS_CONSUME_DIR=/home/rashed/paperless/consume
# Letters and numbers only (A-Z a-z 0-9)
PAPERLESS_DB_PASSWORD=change-me
# Languages of your documents, most common first (deu, eng, fra, ita, spa built in)
PAPERLESS_OCR_LANGUAGE=deu+eng
# Extra languages to download, separated by spaces, e.g. "ben ara". Usually empty.
PAPERLESS_OCR_LANGUAGES=
